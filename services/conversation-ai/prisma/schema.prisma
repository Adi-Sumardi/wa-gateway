datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EscalationReason {
  ai_error
  ai_uncertain
  delivery_failed
}

enum EscalationStatus {
  open
  resolved
}

// userId / deviceId / contactId / messageId reference other services - no
// FK, separate databases.
model AiEscalation {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid @map("user_id")
  deviceId   String           @db.Uuid @map("device_id")
  contactId  String           @db.Uuid @map("contact_id")
  messageId  String?          @db.Uuid @map("message_id")
  question   String
  reason     EscalationReason
  detail     String?
  status     EscalationStatus @default(open)
  resolvedBy String?          @db.Uuid @map("resolved_by")
  resolvedAt DateTime?        @map("resolved_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@map("ai_escalations")
}
